DATABASE_URL=postgresql://budget_user:budget_pass@localhost:5432/budget_db
PORT=3000
FRONTEND_URL=http://localhost:4200

# Comma-separated IBANs of your other accounts (savings etc.). Transfers to/from
# them are imported as `ignored`. The statement's own account is always included.
OWN_IBANS=

# Mailbox import (hourly, plus a catch-up shortly after start). Leave IMAP_HOST
# empty to disable. For Gmail: enable 2-step verification, create an app password
# at https://myaccount.google.com/apppasswords and use it as IMAP_PASSWORD.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
IMAP_PASSWORD=
# Folder to scan. In Gmail a label is a folder, e.g. a label your bank filter applies.
IMAP_FOLDER=INBOX
# Optional: move processed emails here (in Gmail: archive + apply this label).
IMAP_PROCESSED_FOLDER=
IMAP_MARK_SEEN=true
# Comma-separated sender addresses whose emails are imported. Exact match.
IMAP_ALLOWED_SENDERS=
# How far back each check looks, so days the Mac was off are caught up.
IMAP_LOOKBACK_DAYS=14
# Password of the bank's ZIP attachments.
STATEMENT_ZIP_PASSWORD=
