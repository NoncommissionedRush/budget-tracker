generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IncomeConfig {
  id            String   @id @default(cuid())
  monthlyAmount Decimal  @db.Decimal(12, 2)
  incomeDay     Int
  updatedAt     DateTime @updatedAt

  @@map("income_config")
}

model Category {
  id              String        @id @default(cuid())
  name            String
  icon            String        @default("tag")
  color           String        @default("#6366f1")
  allocatedAmount Decimal       @db.Decimal(12, 2)
  activeMonths    Int[]         @default([])
  sortOrder       Int           @default(0)
  isActive        Boolean       @default(true)
  isUnbudgeted    Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  expenses        Expense[]
  subcategories   Subcategory[]

  @@map("categories")
}

model Subcategory {
  id         String    @id @default(cuid())
  categoryId String
  name       String
  amount     Decimal   @db.Decimal(12, 2)
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  category   Category  @relation(fields: [categoryId], references: [id])
  expenses   Expense[]

  @@index([categoryId])
  @@map("subcategories")
}

model Expense {
  id                String           @id @default(cuid())
  categoryId        String
  subcategoryId     String?
  amount            Decimal          @db.Decimal(12, 2)
  description       String
  expenseDate       DateTime         @db.Date
  createdAt         DateTime         @default(now())
  source            ExpenseSource    @default(MANUAL)
  bankTransactionId String?          @unique
  category          Category         @relation(fields: [categoryId], references: [id])
  subcategory       Subcategory?     @relation(fields: [subcategoryId], references: [id])
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id])

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([expenseDate])
  @@map("expenses")
}

enum ExpenseSource {
  MANUAL
  IMPORT
}

enum ImportSource {
  UPLOAD
  EMAIL
}

enum TransactionDirection {
  DEBIT
  CREDIT
}

enum BankTransactionStatus {
  CATEGORIZED
  NEEDS_REVIEW
  IGNORED
}

model ImportBatch {
  id               String            @id @default(cuid())
  source           ImportSource
  messageId        String?
  fileName         String?
  fileHash         String            @unique
  format           String
  statementId      String?
  accountIban      String?
  receivedAt       DateTime          @default(now())
  totalCount       Int               @default(0)
  importedCount    Int               @default(0)
  duplicateCount   Int               @default(0)
  ignoredCount     Int               @default(0)
  errorCount       Int               @default(0)
  errors           Json              @default("[]")
  createdAt        DateTime          @default(now())
  bankTransactions BankTransaction[]

  @@index([messageId])
  @@map("import_batches")
}

model BankTransaction {
  id                String                @id @default(cuid())
  importBatchId     String
  bankTransactionId String                @unique
  accountIban       String?
  bookingDate       DateTime              @db.Date
  valueDate         DateTime?             @db.Date
  transactionDate   DateTime?             @db.Date
  amount            Decimal               @db.Decimal(12, 2)
  currency          String
  direction         TransactionDirection
  counterpartyName  String?
  counterpartyIban  String?
  variableSymbol    String?
  constantSymbol    String?
  specificSymbol    String?
  description       String?
  bankTxCode        String?
  status            BankTransactionStatus
  ignoreReason      String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  importBatch       ImportBatch           @relation(fields: [importBatchId], references: [id])
  expense           Expense?

  @@index([importBatchId])
  @@index([status])
  @@index([bookingDate])
  @@map("bank_transactions")
}
